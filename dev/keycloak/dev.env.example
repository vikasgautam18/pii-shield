# DEV ONLY: settings for the optional Keycloak identity provider (compose profile "auth-dev").
# These credentials are public in this repository: never reuse them anywhere real.
#
# Use:  cat dev/keycloak/dev.env.example >> .env      (remove the AUTH_ENABLED=false line above it)
#       docker compose --profile auth-dev up --build
#
# Playground: http://localhost:7860   Admin: http://localhost:7861   Keycloak: http://localhost:8080
# Users: alice / alice-dev-password (user role), bob / bob-dev-password (admin role),
#        carol / carol-dev-password (no role)

AUTH_ENABLED=true

# Containers reach Keycloak by its service name; browsers use localhost:8080, which is the
# issuer Keycloak stamps into tokens (KC_HOSTNAME), so the API is told what 'iss' to expect.
OIDC_ISSUER_URL=http://keycloak:8080/realms/pii-shield
OIDC_ISSUER=http://localhost:8080/realms/pii-shield
OIDC_ALLOW_INSECURE_HTTP=true

OIDC_AUDIENCE=pii-shield-api
OIDC_ROLES_CLAIM=realm_access.roles

OIDC_CLIENT_ID=pii-shield-ui
OIDC_CLIENT_SECRET=dev-only-ui-client-secret
AUTH_COOKIE_SECRET=dev-only-cookie-secret-0123456789-abcdefghijklmnop
