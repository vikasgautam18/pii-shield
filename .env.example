# PII Shield — Environment Variables
#
# Copy this file to .env and fill in values:
#   cp .env.example .env
#
# Generate a Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Generate an ML-KEM-768 key pair:
#   python -m app.operators.keygen

# --- Encryption backend ---
# "pqc" (default): ML-KEM-768 + AES-256-GCM (post-quantum safe, FIPS 203)
# "fernet": Legacy Fernet (AES-128-CBC + HMAC-SHA256)
ENCRYPTION_BACKEND=pqc

# Required when ENCRYPTION_BACKEND=fernet
PII_SHIELD_ENCRYPTION_KEY=

# Optional when ENCRYPTION_BACKEND=pqc (auto-generated if not set)
# Generate with: python -m app.operators.keygen
PQC_ENCAPSULATION_KEY=
PQC_DECAPSULATION_KEY=

# --- Telemetry / Observability ---
# For local dev: OTLP gRPC endpoint (e.g. Grafana otel-lgtm stack)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4317
#
# For Azure: set this to export directly to App Insights (no OTLP needed)
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# --- NLP Engine ---
# "spacy" (default): en_core_web_lg
# "transformers": HuggingFace BERT NER (PyTorch)
# "onnx": Same as transformers but with ONNX Runtime (2-3x faster CPU inference)
# "stanza": Stanford Stanza
NLP_ENGINE=transformers

# Comma-separated list of Presidio recognizer class names to disable at startup.
# Default removes non-India country-specific recognizers to reduce false positives.
# Set to empty string to keep all built-in recognizers.
DISABLED_RECOGNIZERS=InAadhaarRecognizer,InPanRecognizer,NhsRecognizer,UsBankRecognizer,UsLicenseRecognizer,UsItinRecognizer,UsPassportRecognizer,UsSsnRecognizer,SgFinRecognizer,AuAbnRecognizer,AuAcnRecognizer,AuTfnRecognizer,AuMedicareRecognizer

# HuggingFace model for NLP_ENGINE=transformers or onnx
# TRANSFORMERS_MODEL=dslim/bert-base-NER
# For ONNX with pre-exported model (no PyTorch export needed):
TRANSFORMERS_MODEL=protectai/bert-base-NER-onnx

# ONNX Runtime tuning (only used when NLP_ENGINE=onnx)
# QUANTIZE_MODEL=true          # Use INT8 quantized model (default: true)
# ORT_INTRA_OP_THREADS=2       # Threads per ONNX inference (default: 2, match vCPU)
# ORT_INTER_OP_THREADS=1       # Inter-op parallelism (default: 1)
# NLP_THREAD_POOL_SIZE=6       # Concurrent NLP inferences (default: 6)

# Context similarity factor for Presidio's context-aware enhancer (default: 0.45).
# Higher values give more weight to surrounding text clues when scoring entities.
CONTEXT_SIMILARITY_FACTOR=0.45

# Path to YAML file with recognizer context word overrides.
# Allows customizing context words (e.g., bank names) without code changes.
# See config/recognizer_contexts.yml for format and defaults.
RECOGNIZER_CONTEXTS_FILE=config/recognizer_contexts.yml

# Path to YAML file with custom regex-based recognizers (no code needed).
# Define new entity types with regex patterns, scores, and context words.
# See config/custom_recognizers.yml for format and examples.
# CUSTOM_RECOGNIZERS_FILE=config/custom_recognizers.yml

# Lightweight spaCy model for tokenization (used by transformers/onnx engines)
TRANSFORMERS_SPACY_MODEL=en_core_web_sm

# --- Redis Authentication ---
# "key" (default): Access key in REDIS_URL (on-premises, local Docker)
# "entra": Microsoft Entra managed identity (Azure only, no secrets)
# REDIS_AUTH_MODE=key

# Required when REDIS_AUTH_MODE=entra:
# REDIS_HOST=pii-shield-redis.redis.cache.windows.net
# REDIS_PORT=6380
# REDIS_MANAGED_IDENTITY_TYPE=system   # "system" or "user"
# REDIS_MANAGED_IDENTITY_CLIENT_ID=    # Required when identity type is "user"

# Redis connection pool size (per worker, applies to both key and entra modes)
# REDIS_POOL_SIZE=20

# Streamlit theme for the playground/admin UIs.
# Valid values: default (Streamlit native, default), maroon (burgundy brand look).
# Restart the playground/admin containers after changing.
PII_SHIELD_THEME=default

# --- Authentication (optional OIDC sign-in + bearer-token validation) ---
# ONE master switch controls the API and both UIs (playground + admin):
#   false (default): no sign-in and no token checks. Behaviour is unchanged.
#   true           : the UIs require sign-in; the API requires "Authorization: Bearer <access token>".
# It is read at startup, so restart/redeploy all three services after changing it.
# Works with any OIDC provider (Microsoft Entra ID, Keycloak, Okta, ...).
# Setup guide: docs/authentication.md
AUTH_ENABLED=false

# Identity provider settings (required when AUTH_ENABLED=true).
#   Entra ID : https://login.microsoftonline.com/<tenant-id>/v2.0
#   Keycloak : https://<host>/realms/<realm>
# OIDC_ISSUER_URL=
# Audience(s) the API accepts in access tokens, comma-separated.
# Entra v2 tokens: the API app registration's client ID.
# OIDC_AUDIENCE=
# Claim(s) holding roles, comma-separated; dot-notation works.
# Entra: roles. Keycloak: realm_access.roles
# OIDC_ROLES_CLAIM=roles
# Role names that grant access, comma-separated. The admin role also grants user access.
# AUTH_USER_ROLES=PIIShield.User
# AUTH_ADMIN_ROLES=PIIShield.Admin

# Sign-in client used by the playground and admin UIs (UIs only).
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Scope that makes the IdP issue the access token for this API (required for Entra,
# e.g. api://<api-app-client-id>/access_as_user; usually unnecessary for Keycloak).
# OIDC_API_SCOPE=
# Signs the UI session cookie: at least 32 characters, identical on every replica.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTH_COOKIE_SECRET=
# Redirect URI registered with the IdP for each UI. Leave unset for local runs
# (http://localhost:<port>/oauth2callback is used); set per UI when deployed behind a hostname.
# PLAYGROUND_REDIRECT_URI=https://playground.example.com/oauth2callback
# ADMIN_REDIRECT_URI=https://admin.example.com/oauth2callback

# Advanced (all optional).
# Expected 'iss' when it differs from the discovery URL (split-horizon DNS, local dev IdP).
# OIDC_ISSUER=
# Override the signing-key (JWKS) URL announced by discovery.
# OIDC_JWKS_URL=
# Accepted signing algorithms (asymmetric only; "none" and HS* are never accepted).
# OIDC_ALGORITHMS=RS256
# OIDC_CLOCK_SKEW_SECONDS=60
# OIDC_JWKS_CACHE_SECONDS=3600
# Allow http:// IdP URLs. For a local development IdP only; never in production.
# OIDC_ALLOW_INSECURE_HTTP=false
# Space- or comma-separated; use commas here so the file also stays valid when sourced by a shell.
# OIDC_UI_SCOPES=openid,profile,email
# OIDC_SERVER_METADATA_URL=
# Sign-in prompt behaviour (Streamlit defaults to select_account).
# OIDC_PROMPT=
