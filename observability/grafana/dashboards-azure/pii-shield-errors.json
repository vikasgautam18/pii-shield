      "type": "stat",
      "title": "Total Errors",
      "description": "Total error count across all endpoints in the selected time range",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "azure-monitor-oob"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "customMetrics\n| where name == \"pii.errors\"\n| where $__timeFilter(timestamp)\n| summarize total=sum(value)",
            "resources": [
              "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/__SOURCE_RG__/providers/microsoft.insights/components/__SOURCE_APPI__"
            ],
            "resultFormat": "table"
