{
  "annotations": {
    "list": []
  },
  "title": "PII Shield \u2014 Errors (Azure)",
  "uid": "pii-shield-errors",
  "version": 1,
  "editable": true,
  "description": "Error monitoring for PII Shield: error rates, breakdowns by endpoint and type, error logs, and error traces.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Server Errors (5xx)",
      "description": "Total 5xx server errors across all endpoints",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "azure-monitor-oob"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "customMetrics\n| where name == \"pii.errors\"\n| where $__timeFilter(timestamp)\n| extend status_code = tostring(customDimensions.status_code)\n| where status_code startswith \"5\"\n| summarize total=sum(value)",
            "resources": [
              "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/__SOURCE_RG__/providers/microsoft.insights/components/__SOURCE_APPI__"
            ],
            "resultFormat": "table"
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "azure-monitor-oob"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Client Errors (4xx)",
      "description": "Total 4xx client errors across all endpoints",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "azure-monitor-oob"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "customMetrics\n| where name == \"pii.errors\"\n| where $__timeFilter(timestamp)\n| extend status_code = tostring(customDimensions.status_code)\n| where status_code startswith \"4\"\n| summarize total=sum(value)",
            "resources": [
              "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/__SOURCE_RG__/providers/microsoft.insights/components/__SOURCE_APPI__"
            ],
            "resultFormat": "table"
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
